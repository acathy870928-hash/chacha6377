# ── Claude API ────────────────────────────────────────────────
# https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=sk-ant-...
# 모델 / 추론 강도 (low = 빠르고 저렴, 단순 조회 챗봇에 적합)
BOT_MODEL=claude-opus-5
BOT_EFFORT=low
BOT_MAX_TOKENS=16000
# 안전 분류기가 요청을 거절했을 때 서버가 다른 모델로 자동 우회
BOT_SERVER_SIDE_FALLBACK=true

# ── 사용자 / 데이터 ───────────────────────────────────────────
# "내 업무" 로 물었을 때 기본으로 볼 담당자 이름 (DB의 owner 값과 맞출 것)
BOT_DEFAULT_OWNER=나
BOT_DB_PATH=./data/workflow.db

# ── 서버 ─────────────────────────────────────────────────────
BOT_PORT=3978
BOT_HOST=127.0.0.1
# 웹 UI 를 사내망/외부에 열 때 필요한 접근 토큰.
# 비워두면 127.0.0.1 접속만 허용된다. (열려면 BOT_HOST=0.0.0.0 + 토큰 설정)
BOT_WEB_ACCESS_TOKEN=

# ── 대화 ─────────────────────────────────────────────────────
BOT_MAX_HISTORY_TURNS=20
BOT_SESSION_TTL_MINUTES=120
BOT_MAX_TOOL_ITERATIONS=8

# ── Microsoft Teams (Azure Bot 등록 후 입력) ──────────────────
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
MICROSOFT_APP_TENANT_ID=
MICROSOFT_APP_TYPE=MultiTenant
