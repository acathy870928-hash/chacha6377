# 임베딩 제공자: voyage | openai | hash
# - voyage : 다국어(한국어) 품질이 좋아 약관 검색에 기본 권장
# - openai : text-embedding-3-* 사용
# - hash   : API 키 없이 동작하는 오프라인 폴백. 테스트/데모 전용이며 검색 품질이 낮음
EMBEDDING_PROVIDER=voyage

VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5

OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# 답변 생성(Claude)
ANTHROPIC_API_KEY=
ANSWER_MODEL=claude-opus-5

# 청킹 파라미터 (문자 수 기준)
CHUNK_MAX_CHARS=1200
CHUNK_MIN_CHARS=200
CHUNK_OVERLAP_CHARS=120
