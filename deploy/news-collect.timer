[Unit]
Description=사업단 뉴스 브리핑 - 매일 아침 기사 수집

[Timer]
# 매일 아침 7시(한국 시간). 대표가 출근해서 볼 때 후보가 쌓여 있도록.
# 서버 시간대는 install.sh 가 Asia/Seoul 로 맞춰둔다.
OnCalendar=*-*-* 07:00:00

# 매체 서버에 같은 시각으로 몰리지 않게 최대 5분 흩뿌린다
RandomizedDelaySec=300

# 그 시각에 서버가 꺼져 있었으면 켜진 뒤 한 번 돌린다
Persistent=true

[Install]
WantedBy=timers.target
