[Unit]
Description=사업단 뉴스 브리핑
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=news
Group=news
WorkingDirectory=/srv/news-briefing
EnvironmentFile=/srv/news-briefing/.env
ExecStart=/srv/news-briefing/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

# 이 서비스가 건드릴 수 있는 범위를 좁혀둔다
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/news-briefing/data

[Install]
WantedBy=multi-user.target
